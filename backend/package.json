{
  "name": "ecommerce-backend-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade E-Commerce Microservices Backend Monorepo",
  "workspaces": [
    "shared",
    "api-gateway",
    "services/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=shared",
    "build:gateway": "npm run build --workspace=api-gateway",
    "build:services": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=api-gateway",
    "dev:auth": "npm run dev --workspace=services/auth-service",
    "dev:product": "npm run dev --workspace=services/product-service",
    "dev:vendor": "npm run dev --workspace=services/vendor-service",
    "dev:inventory": "npm run dev --workspace=services/inventory-service",
    "dev:order": "npm run dev --workspace=services/order-service",
    "dev:payment": "npm run dev --workspace=services/payment-service",
    "dev:notification": "npm run dev --workspace=services/notification-service",
    "dev:cart": "npm run dev --workspace=services/cart-service",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
