# ==============================================================================
# Nati Store — Production Environment Configuration Template
# All secret values must be provided via deployment environment settings (e.g. Vercel)
# NEVER commit real credentials, production secrets, or private keys to git.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nati_store?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password
ADMIN_NAME="System Administrator"

# Stripe Payment Gateway (Test or Live API Keys from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# URLs & CORS Whitelist
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_API_URL=https://your-domain.vercel.app/api
ALLOWED_ORIGINS=https://your-domain.vercel.app

# Optional Infrastructure (Microservices Architecture only)
REDIS_URL=redis://default:<password>@<host>:<port>
RABBITMQ_URL=amqps://<username>:<password>@<host>/<vhost>
